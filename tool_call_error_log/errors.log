{"timestamp":"2026-09-08 17:10:45","tool":"Bash","input":{"command":"python - \u003c\u003c\u0027EOF\u0027\nimport torch, time\nimport amd_tuned_torch.fftconv_ops as m\n\ndef old_complex_matmul(a, b, groups=1):\n    a = a.view(a.size(0), groups, -1, *a.shape[2:])\n    b = b.view(groups, -1, *b.shape[1:])\n    a = torch.movedim(a, 2, a.dim() - 1).unsqueeze(-2)\n    b = torch.movedim(b, (1, 2), (b.dim() - 1, b.dim() - 2))\n    real = a.real @ b.real - a.imag @ b.imag\n    imag = a.imag @ b.real + a.real @ b.imag\n    real = torch.movedim(real, real.dim() - 1, 2).squeeze(-1)\n    imag = torch.movedim(imag, imag.dim() - 1, 2).squeeze(-1)\n    c = torch.zeros(real.shape, dtype=torch.complex64, device=a.device)\n    c.real, c.imag = real, imag\n    return c.view(c.size(0), -1, *c.shape[3:])\n\ntorch.manual_seed(0)\na = torch.randn(4, 64, 4096, dtype=torch.complex64)\nb = torch.randn(128, 64, 4096, dtype=torch.complex64)\n\nout_new = m.complex_matmul(a.clone(), b.clone(), groups=1)\nout_old = old_complex_matmul(a.clone(), b.clone(), groups=1)\nprint(\"match:\", torch.allclose(out_new, out_old, atol=1e-4))\n\nN = 20\nt0 = time.perf_counter()\nfor _ in range(N): old_complex_matmul(a, b, groups=1)\nt1 = time.perf_counter()\nfor _ in range(N): m.complex_matmul(a, b, groups=1)\nt2 = time.perf_counter()\nprint(f\"old: {(t1-t0)/N*1000:.3f} ms, new: {(t2-t1)/N*1000:.3f} ms, speedup: {(t1-t0)/(t2-t1):.2f}x\")\nEOF","description":"Benchmark old vs new complex_matmul on CPU"},"response":null}
{"timestamp":"2026-09-08 17:21:20","tool":"Bash","input":{"command":"python - \u003c\u003c\u0027EOF\u0027\nimport importlib.util, torch, torch.nn.functional as F, time\n\ndef load(name, path):\n    spec = importlib.util.spec_from_file_location(name, path)\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    return mod\n\nks = load(\"kernel_select\", \"amd_tuned_torch/kernel_select.py\")\nfc = load(\"fftconv_ops\", \"amd_tuned_torch/fftconv_ops.py\")\n\nks.reset()\n\ntorch.manual_seed(0)\n# Large-kernel case: fftconv should win (or at least produce a correct, verified result)\nx = torch.randn(2, 8, 8192)\nw = torch.randn(8, 8, 2049)\n\ncandidates = [\n    (\"fftconv\", lambda: fc.fftconv1d_candidate(x, w, None, 1, 1024, 1, 1)),\n    (\"stock\", lambda: F.conv1d(x, w, padding=1024)),\n]\nout = ks.pick(\"conv1d\", x, w, 1, 1024, 1, candidates, tolerance=fc.fftconv_tolerance(x.dtype))\nref = F.conv1d(x, w, padding=1024)\nprint(\"correct:\", torch.allclose(out, ref, rtol=1e-3, atol=1e-3))\nprint(\"winner:\", ks.debug_winners())\nprint(\"bad:\", ks.debug_bad_candidates())\nEOF","description":"End-to-end real contest test on CPU with a large-kernel conv1d case"},"response":null}
