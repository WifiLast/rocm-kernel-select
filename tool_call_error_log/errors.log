{"timestamp":"2026-09-09 13:56:14","tool":"Bash","input":{"command":"cd /c/Users/MartinStark/Documents/GitHub/PLS/amd_tools\npython -c \"\nimport torch\nfrom typing import Optional\n\n@torch.library.custom_op(\u0027test_ns::maybe_op\u0027, mutates_args=())\ndef maybe_op(x: torch.Tensor, flag: bool) -\u003e Optional[torch.Tensor]:\n    if not flag:\n        return None\n    return x * 2\n\n@maybe_op.register_fake\ndef _fake(x: torch.Tensor, flag: bool) -\u003e Optional[torch.Tensor]:\n    if not flag:\n        return None\n    return x.new_empty(x.shape)\n\n# real call\nx = torch.randn(3)\nprint(\u0027real True:\u0027, maybe_op(x, True))\nprint(\u0027real False:\u0027, maybe_op(x, False))\n\n# fake call\nfrom torch._subclasses.fake_tensor import FakeTensorMode\nwith FakeTensorMode():\n    fx = torch.randn(3)\n    out_true = torch.ops.test_ns.maybe_op(fx, True)\n    out_false = torch.ops.test_ns.maybe_op(fx, False)\n    print(\u0027fake True shape:\u0027, out_true.shape if out_true is not None else None)\n    print(\u0027fake False:\u0027, out_false)\nprint(\u0027torch version:\u0027, torch.__version__)\n\"\n","description":"Empirically verify torch.library.custom_op supports Optional[Tensor] returns and register_fake handles None correctly"},"response":null}
