// Hand-written implicit-GEMM Conv3d (FP16, WMMA matrix-core tiled) for
// amd_tuned_torch on ROCm/RDNA3 (RX 7900 XTX, gfx1100). Ported from the
// original CMP-Turing project's CUDA kernel
// (src/cuda/kernel_example/fp16_conv3d.cu) -- a direct extension of
// conv2d_fp16's design with an extra depth (K_D/D_out) decomposition
// level in the flattened GEMM-K axis. See conv2d_fp16.cu.tmpl's header
// comment for the WMMA rewrite rationale/design (gfx1100's real
// matrix-core instructions via rocWMMA instead of manual half2 HFMA2) --
// that part ports mechanically since it only touches the compute/epilogue,
// not the im2col indexing this file's LOAD_A specializes.
//
// This is a tools/kernelgen TEMPLATE, not a compiled source file -- the
// actual .cu files live under src/cuda/generated/conv3d_fp16_*.cu, one per
// tile shape listed in tools/kernelgen/variants.py, each rendered from
// this file by tools/kernelgen/generate.py substituting $$BM/$$BN/$$BK/
// $$STAGES/$$SUFFIX. Edit this template (and re-run generate.py) rather
// than hand-editing a generated .cu.
//
// M = output voxels (B*D_out*H_out*W_out), N = C_out,
// K = C_in*K_D*K_H*K_W. Tile shape (BM=$BM, BN=$BN, BK=$BK, STAGES=$STAGES
// for this generated file) is fixed at codegen time, not build time. BK
// must be a multiple of WMMA_K (16); BM/BN must be multiples of 32.
// Building this needs rocWMMA (rocwmma-dev / the rocWMMA headers) on the
// include path -- see ../../../setup.py and README.md's "Build
// prerequisites".
#include <hip/hip_runtime.h>
#include <hip/hip_fp16.h>
#include <rocwmma/rocwmma.hpp>

#define BM $BM
#define BN $BN
#define BK $BK
#define STAGES $STAGES

// WMMA tile shape -- fixed by gfx1100's matrix-core ISA (16x16x16 is the
// only FP16-input/FP32-accumulate WMMA size RDNA3 supports).
#define WMMA_M 16
#define WMMA_N 16
#define WMMA_K 16

// Each warp's 32x32 output sub-tile is a 2x2 grid of WMMA_M x WMMA_N tiles.
#define WARP_TILES_M 2
#define WARP_TILES_N 2
// Flat iteration count over that 2x2 grid -- accum[][]/fragA[]/fragB[] are
// indexed back out of a single loop variable (i = t/WARP_TILES_N, j =
// t%WARP_TILES_N) wherever both dimensions are walked together, instead of
// nesting two #pragma unroll loops.
#define WARP_TILES (WARP_TILES_M * WARP_TILES_N)

#define PAD 8

// Epilogue scratch-buffer row padding, in floats. The epilogue reads that
// buffer down a column (one lane per output voxel -- see the epilogue
// itself), so the row stride must not be a multiple of the 32-bank LDS
// stride, or every lane collides on one bank. 1 float is enough: it makes
// the stride odd, hence coprime with 32.
#define EPI_PAD 1

#define BLOCK_SIZE ((BM / 32) * (BN / 32) * 32)
#define A_TILE_INT4 (BM * (BK / 8))
#define B_TILE_INT4 (BK * (BN / 8))

namespace {

using rocwmma::matrix_a;
using rocwmma::matrix_b;
using rocwmma::accumulator;
using rocwmma::row_major;
using rocwmma::float16_t;
using rocwmma::float32_t;
using rocwmma::mem_row_major;

static_assert(BM % 32 == 0, "BM must be a multiple of 32");
static_assert(BN % 32 == 0, "BN must be a multiple of 32");
static_assert(BK % WMMA_K == 0, "BK must be a multiple of 16");

using FragA   = rocwmma::fragment<matrix_a, WMMA_M, WMMA_N, WMMA_K, float16_t, row_major>;
using FragB   = rocwmma::fragment<matrix_b, WMMA_M, WMMA_N, WMMA_K, float16_t, row_major>;
using FragAcc = rocwmma::fragment<accumulator, WMMA_M, WMMA_N, WMMA_K, float32_t>;

__global__ void __launch_bounds__(BLOCK_SIZE) conv3d_fp16_kernel_$SUFFIX(
    const half* __restrict__ input,     // [B, C_in, D_in, H_in, W_in]
    const half* __restrict__ weight,    // [C_out, C_in*KD*KH*KW]  (GEMM-layout)
    const half* __restrict__ bias,
    half* __restrict__ output,          // [B, C_out, D_out, H_out, W_out]
    int B, int C_in, int D_in, int H_in, int W_in,
    int C_out, int K_D, int K_H, int K_W,
    int D_out, int H_out, int W_out,
    int s_d, int s_h, int s_w, int p_d, int p_h, int p_w, int d_d, int d_h, int d_w)
{
    extern __shared__ char smem_raw[];

    half (*As)[BM][BK + PAD] = reinterpret_cast<half (*)[BM][BK + PAD]>(smem_raw);
    half (*Bs)[BK][BN + PAD] = reinterpret_cast<half (*)[BK][BN + PAD]>(
        smem_raw + STAGES * BM * (BK + PAD) * sizeof(half));

    // Per-warp accumulator: 2x2 grid of 16x16 FP32 fragments (32x32 output).
    FragAcc accum[WARP_TILES_M][WARP_TILES_N];
    #pragma unroll
    for (int t = 0; t < WARP_TILES; t++)
        rocwmma::fill_fragment(accum[t / WARP_TILES_N][t % WARP_TILES_N], 0.0f);

    int tid = threadIdx.x;
    int bx  = blockIdx.x;   // Output channel block
    int by  = blockIdx.y;   // Voxel block

    int warp_id = tid / 32;

    int warp_n_count = BN / 32;
    int warp_m = warp_id / warp_n_count;
    int warp_n = warp_id % warp_n_count;

    int block_pixel_start   = by * BM;
    int block_channel_start = bx * BN;

    int voxels_per_batch = D_out * H_out * W_out;
    int total_voxels     = B * voxels_per_batch;
    int total_k           = C_in * K_D * K_H * K_W;
    int stride_hw          = H_out * W_out;
    int stride_bvox        = C_out * voxels_per_batch;

    int max_k_tiles = (total_k + BK - 1) / BK;

    // Flat K index decomposes to (c_in, kd, kh, kw); voxel index decomposes
    // to (b, d_out, h_out, w_out) via voxels_per_batch/stride_hw.
// PERF: same fix as conv2d_fp16.cu.tmpl's LOAD_A, and it matters more
// here -- the 3D flat GEMM-K index is a four-axis mixed-radix counter
// (kv wraps at K_W into ku, ku at K_H into kd, kd at K_D into kc), so the
// original port paid SIX runtime integer divisions per loaded half, and
// gfx1100 has no hardware integer divide. Decompose once per int4 slot,
// then carry the counter one step per v (ck grows by 1, so at most one
// carry propagates per step) and let the input offset ride along as four
// running partial sums advanced by those same carries -- no divisions and
// no multiplies in the inner loop. See that file for the measured impact.
#define LOAD_A(s, k_base)                                                   \
    do {                                                                     \
        for (int _i = tid; _i < A_TILE_INT4; _i += BLOCK_SIZE) {            \
            int a_row = _i / (BK / 8);                                      \
            int a_col = (_i % (BK / 8)) * 8;                                \
            int4 lv = make_int4(0,0,0,0);                                   \
            half* vd = reinterpret_cast<half*>(&lv);                        \
            int pixel_idx = block_pixel_start + a_row;                      \
            bool valid_pixel = (pixel_idx < total_voxels);                  \
            int kb = (k_base) + a_col;                                      \
            if (valid_pixel && kb < total_k) {                              \
                int rem      = pixel_idx % voxels_per_batch;                \
                int p_b_idx  = pixel_idx / voxels_per_batch;                \
                int p_d_out  = rem / stride_hw;                             \
                int rem2     = rem % stride_hw;                             \
                int p_h_out  = rem2 / W_out;                                \
                int p_w_out  = rem2 % W_out;                                \
                int hw       = H_in * W_in;                                  \
                int dhw      = D_in * hw;                                    \
                int in_base  = (p_b_idx * C_in) * dhw;                      \
                int d_org    = p_d_out * s_d - p_d;                          \
                int h_org    = p_h_out * s_h - p_h;                          \
                int w_org    = p_w_out * s_w - p_w;                          \
                int d_org_hw = d_org * hw;                                   \
                int h_org_w  = h_org * W_in;                                 \
                int dd_hw    = d_d * hw;                                     \
                int dh_w     = d_h * W_in;                                   \
                int tmp = kb;                                                \
                int kv  = tmp % K_W; tmp /= K_W;                            \
                int ku  = tmp % K_H; tmp /= K_H;                            \
                int kd  = tmp % K_D;                                         \
                int kc  = tmp / K_D;                                         \
                int c_off = kc * dhw;                                         \
                int d_in  = d_org + kd * d_d;                                \
                int d_off = d_org_hw + (kd * dd_hw);                         \
                int h_in  = h_org + ku * d_h;                                \
                int h_off = h_org_w + (ku * dh_w);                          \
                int w_in  = w_org + kv * d_w;                                \
                _Pragma("unroll")                                            \
                for (int v = 0; v < 8; ++v) {                               \
                    if (kb + v < total_k) {                                  \
                        if (d_in >= 0 && d_in < D_in && h_in >= 0 && h_in < H_in && w_in >= 0 && w_in < W_in) \
                            vd[v] = input[in_base + c_off + d_off + h_off + w_in]; \
                        w_in += d_w;                                         \
                        if (++kv == K_W) {                                   \
                            kv = 0; w_in = w_org;                            \
                            h_in += d_h; h_off += dh_w;                     \
                            if (++ku == K_H) {                               \
                                ku = 0; h_in = h_org; h_off = h_org_w;      \
                                d_in += d_d; d_off += dd_hw;                \
                                if (++kd == K_D) {                           \
                                    kd = 0; d_in = d_org; d_off = d_org_hw; \
                                    c_off += dhw;                            \
                                }                                            \
                            }                                                \
                        }                                                    \
                    }                                                        \
                }                                                            \
            }                                                                \
            *reinterpret_cast<int4*>(&As[(s)][a_row][a_col]) = lv;          \
        }                                                                    \
    } while(0)

#define LOAD_B(s, k_base)                                                   \
    do {                                                                     \
        for (int _i = tid; _i < B_TILE_INT4; _i += BLOCK_SIZE) {            \
            int b_row = _i / (BN / 8);                                      \
            int b_col = (_i % (BN / 8)) * 8;                                \
            int gn = block_channel_start + b_col;                          \
            int gk = (k_base) + b_row;                                     \
            int4 lv = make_int4(0,0,0,0);                                   \
            half* vd = reinterpret_cast<half*>(&lv);                        \
            if (gn < C_out && gk < total_k) {                               \
                _Pragma("unroll")                                            \
                for (int v = 0; v < 8; ++v) {                               \
                    int cn = gn + v;                                         \
                    if (cn < C_out)                                          \
                        vd[v] = weight[cn * total_k + gk];                  \
                }                                                            \
            }                                                                \
            *reinterpret_cast<int4*>(&Bs[(s)][b_row][b_col]) = lv;          \
        }                                                                    \
    } while(0)

    if (max_k_tiles > 0) {
        LOAD_A(0, 0);
        LOAD_B(0, 0);
        __syncthreads();
    }

    // Main loop -- genuinely double-buffered: ONE barrier per iteration,
    // after both the prefetch and the compute. PERF: a second barrier used
    // to sit between the prefetch and the compute, which serialized
    // global-load latency against matrix-core throughput even though the
    // two touch disjoint stages -- see conv2d_fp16.cu.tmpl's main loop for
    // the full reasoning; the pipeline invariants are identical here.
    for (int k_step = 0; k_step < max_k_tiles; k_step++) {
        int compute_idx = k_step       % STAGES;
        int load_idx    = (k_step + 1) % STAGES;

        if (k_step + 1 < max_k_tiles) {
            int next_k = (k_step + 1) * BK;
            LOAD_A(load_idx, next_k);
            LOAD_B(load_idx, next_k);
        }

        // Compute the warp's 32x32 output sub-tile via WMMA, walking BK in
        // WMMA_K=16 chunks. As/Bs are row-major with ld = BK+PAD / BN+PAD
        // respectively, matching wmma's row_major layout directly.
        #pragma unroll
        for (int k16 = 0; k16 < BK; k16 += WMMA_K) {
            FragA fragA[WARP_TILES_M];
            FragB fragB[WARP_TILES_N];

            #pragma unroll
            for (int i = 0; i < WARP_TILES_M; i++)
                rocwmma::load_matrix_sync(
                    fragA[i],
                    reinterpret_cast<const float16_t*>(&As[compute_idx][warp_m * 32 + i * WMMA_M][k16]),
                    BK + PAD);

            #pragma unroll
            for (int j = 0; j < WARP_TILES_N; j++)
                rocwmma::load_matrix_sync(
                    fragB[j],
                    reinterpret_cast<const float16_t*>(&Bs[compute_idx][k16][warp_n * 32 + j * WMMA_N]),
                    BN + PAD);

            #pragma unroll
            for (int t = 0; t < WARP_TILES; t++) {
                int i = t / WARP_TILES_N, j = t % WARP_TILES_N;
                rocwmma::mma_sync(accum[i][j], fragA[i], fragB[j], accum[i][j]);
            }
        }

        __syncthreads();
    }

#undef LOAD_A
#undef LOAD_B

    // Epilogue -- see conv2d_fp16.cu.tmpl's header comment for why this
    // can't be a direct store_matrix_sync: stage through a small LDS
    // scratch buffer (aliasing the dead As/Bs region), one BM-row-of-warps
    // per pass, then scatter to global memory with bias-add + FP32->FP16
    // cast. rem = m_idx % voxels_per_batch is already the correct flat
    // (d_out, h_out, w_out) offset within a channel -- no need to
    // decompose it further here, same as 2D only needing (b_idx, rem).
    float (*epi)[BN + EPI_PAD] = reinterpret_cast<float (*)[BN + EPI_PAD]>(smem_raw);

    for (int pass = 0; pass < BM / 32; pass++) {
        if (warp_m == pass) {
            #pragma unroll
            for (int t = 0; t < WARP_TILES; t++) {
                int i = t / WARP_TILES_N, j = t % WARP_TILES_N;
                rocwmma::store_matrix_sync(
                    &epi[i * WMMA_M][warp_n * 32 + j * WMMA_N],
                    accum[i][j], BN + EPI_PAD, mem_row_major);
            }
        }
        __syncthreads();

        // PERF: the lane index walks r (the output VOXEL), not c (the
        // output channel) -- output is [B, C_out, D_out, H_out, W_out], so
        // channels are D_out*H_out*W_out apart and the original c-major
        // walk had all 32 lanes of a wave storing 2 bytes each to 32
        // addresses that far apart, touching one cache line per lane per
        // store for every output element in the tensor. See
        // conv2d_fp16.cu.tmpl's epilogue for the full reasoning and for
        // what EPI_PAD protects against once the LDS access inverts.
        for (int idx = tid; idx < 32 * BN; idx += BLOCK_SIZE) {
            int r = idx % 32;
            int c = idx / 32;
            int m_idx = block_pixel_start + pass * 32 + r;
            int n_idx = block_channel_start + c;
            if (m_idx < total_voxels && n_idx < C_out) {
                float val = epi[r][c];
                if (bias) val += __half2float(bias[n_idx]);
                int b_idx = m_idx / voxels_per_batch;
                int rem   = m_idx % voxels_per_batch;
                output[b_idx * stride_bvox + n_idx * voxels_per_batch + rem] = __float2half(val);
            }
        }

        __syncthreads();  // all reads of epi[] done before next pass overwrites it
    }
}

}  // namespace

void launch_conv3d_fp16_$SUFFIX(
    const void* input, const void* weight, const void* bias, void* output,
    int B, int C_in, int D_in, int H_in, int W_in,
    int C_out, int K_D, int K_H, int K_W,
    int D_out, int H_out, int W_out,
    int s_d, int s_h, int s_w,
    int p_d, int p_h, int p_w,
    int d_d, int d_h, int d_w,
    hipStream_t stream)
{
    const half* input_ptr  = reinterpret_cast<const half*>(input);
    const half* weight_ptr = reinterpret_cast<const half*>(weight);
    const half* bias_ptr   = reinterpret_cast<const half*>(bias);
    half*       output_ptr = reinterpret_cast<half*>(output);

    long long total = (long long)B * C_out * D_out * H_out * W_out;
    if (total <= 0) return;

    int m = B * D_out * H_out * W_out;
    int n = C_out;

    dim3 block(BLOCK_SIZE);
    dim3 grid((n + BN - 1) / BN,
              (m + BM - 1) / BM);

    // Same smem footprint math as conv2d_fp16 -- depends only on
    // STAGES/BM/BK/PAD/BN, unaffected by the extra K decomposition level.
    // epi_bytes is max()'d in rather than assumed to fit inside as+bs --
    // see tools/kernelgen/variants.py for this variant's actual
    // BM/BN/BK/STAGES.
    int as_bytes    = STAGES * BM * (BK + PAD) * sizeof(half);
    int bs_bytes    = STAGES * BK * (BN + PAD) * sizeof(half);
    int epi_bytes   = 32 * (BN + EPI_PAD) * (int)sizeof(float);
    int total_smem  = as_bytes + bs_bytes;
    if (epi_bytes > total_smem) total_smem = epi_bytes;

    static bool smem_attrs_set = false;
    if (!smem_attrs_set) {
        // (void): ROCm 7 marks hipError_t [[nodiscard]]. A failure here
        // would mean the dynamic-LDS opt-in didn't take, which the very next
        // launch reports through hipGetLastError() at the dispatch layer --
        // there is nothing useful to do with the status at this point.
        (void)hipFuncSetAttribute(reinterpret_cast<const void*>(conv3d_fp16_kernel_$SUFFIX),
                                   hipFuncAttributeMaxDynamicSharedMemorySize, total_smem);
        smem_attrs_set = true;
    }

    hipLaunchKernelGGL((conv3d_fp16_kernel_$SUFFIX), grid, block, total_smem, stream,
                        input_ptr, weight_ptr, bias_ptr, output_ptr,
                        B, C_in, D_in, H_in, W_in,
                        C_out, K_D, K_H, K_W, D_out, H_out, W_out,
                        s_d, s_h, s_w, p_d, p_h, p_w, d_d, d_h, d_w);
}
