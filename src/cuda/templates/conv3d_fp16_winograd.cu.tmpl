// =================================================================================
// conv3d_fp16_winograd.cu.tmpl -- F(2x2x2, 3x3x3) 3D Winograd conv3d (FP16)
// for amd_tuned_torch on ROCm/RDNA3 (RX 7900 XTX, gfx1100). Ported from
// this project's own src/cuda/conv3d_fp32_winograd.cu -- same transform
// math, same three-kernel split, same register-blocked accumulate step --
// with two changes: the dtype, and the file is now a tools/kernelgen
// TEMPLATE (the actual .cu files live under
// src/cuda/generated/conv3d_fp16_winograd_*.cu, one per BT_TILES/BT_COUT
// blocking factor in tools/kernelgen/variants.py, rendered by
// tools/kernelgen/generate.py substituting $$BT_TILES/$$BT_COUT/$$SUFFIX).
// Edit this template (and re-run generate.py) rather than hand-editing a
// generated .cu.
//
// PRECISION: mixed, not plain fp16 throughout. input/weight/bias/output
// and the two large intermediate buffers (U, V) are all `half` -- that's
// where the actual fp16 win is: U and V dominate this kernel's memory
// traffic (U is C_out*C_in*64 elements, V is C_in*total_tiles*64), so
// halving their footprint is the point of this file existing at all.
// Every transform (filter/input/output) and kernel 3's C_in-reduction
// accumulate run in `float` internally -- half values are widened via
// __half2float() right after each global-memory read and narrowed via
// __float2half() right before each store, exactly the same discipline
// conv2d_fp16.cu.tmpl/conv3d_fp16.cu.tmpl use for their WMMA accumulators.
// This isn't optional caution: Winograd's transform coefficients (halves,
// sign flips, sums of up to 4 terms per stage, applied 3 times separably
// per tensor) are known to amplify rounding error more than a plain
// direct/GEMM convolution's single ordered reduction would -- running the
// transforms themselves in fp16 risks compounding that on top of the
// reduced mantissa, with no way to bound it analytically here. Storage-
// only fp16 with float compute is the standard mitigation (mirrors how
// production Winograd implementations that support fp16 I/O handle this).
//
// UNVALIDATED: unlike conv3d_fp32_winograd.cu (verified against a direct
// CPU reference to ~3e-8 max abs diff, float32 rounding only, on the
// original CUDA/Turing build -- see that file's header), this fp16 port
// has not been run at all, on any hardware. Winograd's error profile
// under fp16 is fundamentally different from the direct/WMMA conv
// kernels' (fewer, larger-magnitude-swing terms per output vs. many
// small ordered accumulations), so tests_hardware/test_conv_kernels.py's
// existing 1e-2/1e-2 fp16 tolerance (tuned for the WMMA kernels'
// cross-implementation-summation-order concern, not Winograd's
// transform-amplification one) should NOT be assumed to hold here --
// determine an appropriate tolerance empirically (e.g. by comparing
// against conv3d_fp32_winograd.cu or F.conv3d in fp64) before trusting
// this on real shapes.
//
// NOT YET WIRED INTO DISPATCH: no src/main_rocm.cpp integration exists
// for this yet (unlike conv3d_fp32_winograd.cu, which run_conv3d_fp32
// benchmarks against the direct fp32 kernel per shape and caches the
// winner). This generates and should build, but nothing calls it.
//
// Everything below this point (the transform math, the three-kernel
// split rationale, the register-blocking rationale, the FMA note, the
// scope-limitation list) is unchanged from conv3d_fp32_winograd.cu --
// only the dtype changed, so only the parts that differ from that file
// are re-explained here. Read that file's header alongside this one.
//
// Separable 3D extension of the standard 1D F(2,3) Winograd transform
// (Lavin & Gray, "Fast Algorithms for Convolutional Neural Networks"):
//   filter transform (G):   3-tap g -> 4-tap U
//     U0 = g0
//     U1 = 0.5*(g0+g1+g2)
//     U2 = 0.5*(g0-g1+g2)
//     U3 = g2
//   input transform (B^T):  4-tap d -> 4-tap V
//     V0 = d0-d2
//     V1 = d1+d2
//     V2 = d2-d1
//     V3 = d1-d3
//   output transform (A^T): 4-tap m -> 2-tap output
//     out0 = m0+m1+m2
//     out1 = m1-m2-m3
// Applied along each of D,H,W in turn (separability).
//
// Three kernels (avoids redundantly re-transforming the same input tile
// once per output channel):
//   1. filter transform:  g[Cout][Cin][3][3][3] -> U[Cout][Cin][4][4][4]
//   2. input transform:   input[Cin][D][H][W]   -> V[Cin][tile][4][4][4]
//   3. accumulate+output: per (tile,Cout) BLOCK: M[pos] = sum_Cin
//      U[Cout][Cin][pos]*V[Cin][tile][pos] for pos in 64 transform-domain
//      positions, then output-transform -> 2x2x2, +bias.
//
// Kernel 3 is register-blocked (BT_TILES x BT_COUT output tiles per
// block, not one) -- per conv3d_fp32_winograd.cu's measurements, this
// isn't optional: an unblocked version was slower than the direct kernel
// despite doing far fewer multiplies, because every block re-read the
// entire U[cout]/V[tile] row from global memory redundantly. BT_TILES=8/
// BT_COUT=8 here reproduces that file's blocking factor as a starting
// point -- not re-tuned for fp16's different register/LDS footprint per
// thread, let alone RDNA3 specifically (that file's own header already
// flags it as untuned for RDNA3 even in fp32).
//
// Scope limitations (enforced by the launcher's guard, checked first,
// before any allocation): D_in/H_in/W_in must be even; the resulting tile
// count and C_out must both be divisible by BT_TILES/BT_COUT; batch=1
// only; kernel=3x3x3/stride=1/padding=1/dilation=1 only. Anything else
// falls back to whatever the caller's non-Winograd path is.
//
// FMA: every multiply is written as a separate statement from any
// addition it feeds into, matching every other kernel in this project --
// see conv3d_fp32_winograd.cu's header for why (no hipcc
// -ffp-contract=off equivalent wired into this project's build; this is
// a precision-reproducibility note, not a known bug).
// =================================================================================

#include <hip/hip_runtime.h>
#include <hip/hip_fp16.h>

#define WINOGRAD_BT_TILES $BT_TILES
#define WINOGRAD_BT_COUT $BT_COUT

namespace {

// M[BT_TILES][BT_COUT][64] (kernel 3's shared-memory accumulator buffer,
// see below) must fit RDNA3's 64KB LDS/workgroup budget at 4 bytes/float.
static_assert(WINOGRAD_BT_TILES > 0 && WINOGRAD_BT_COUT > 0 &&
              WINOGRAD_BT_TILES * WINOGRAD_BT_COUT * 64 * 4 <= 65536,
              "WINOGRAD_BT_TILES * WINOGRAD_BT_COUT is too large for the "
              "kernel 3 shared-memory accumulator to fit RDNA3's 64KB LDS "
              "budget");

__device__ __forceinline__ void g_transform_1d(const float g[3], float U[4]) {
    U[0] = g[0];
    U[1] = 0.5f * (g[0] + g[1] + g[2]);
    U[2] = 0.5f * (g[0] - g[1] + g[2]);
    U[3] = g[2];
}

__device__ __forceinline__ void bt_transform_1d(const float d[4], float V[4]) {
    V[0] = d[0] - d[2];
    V[1] = d[1] + d[2];
    V[2] = d[2] - d[1];
    V[3] = d[1] - d[3];
}

__device__ __forceinline__ void at_transform_1d(const float m[4], float out[2]) {
    out[0] = m[0] + m[1] + m[2];
    out[1] = m[1] - m[2] - m[3];
}

// ---------------------------------------------------------------------
// Kernel 1: filter transform. One thread per (cout,cin) pair -- small,
// fully unrolled 3x3x3 -> 4x4x4 separable transform. g/U are half in
// memory; the transform itself runs in float (widen on read, narrow on
// the final store) -- see file header.
// ---------------------------------------------------------------------
__global__ void winograd_filter_transform_fp16_$SUFFIX(
    const half* __restrict__ g,   // [Cout][Cin][3][3][3]
    half* __restrict__ U,         // [Cout][Cin][4][4][4]
    int C_out, int C_in)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= C_out * C_in) return;
    const half* gp = g + (size_t)idx * 27;
    half* Up = U + (size_t)idx * 64;

    float t0[4][3][3];
    for (int h = 0; h < 3; ++h)
        for (int w = 0; w < 3; ++w) {
            float col[3] = {__half2float(gp[0*9+h*3+w]), __half2float(gp[1*9+h*3+w]), __half2float(gp[2*9+h*3+w])};
            float out4[4];
            g_transform_1d(col, out4);
            for (int a = 0; a < 4; ++a) t0[a][h][w] = out4[a];
        }
    float t1[4][4][3];
    for (int d = 0; d < 4; ++d)
        for (int w = 0; w < 3; ++w) {
            float col[3] = {t0[d][0][w], t0[d][1][w], t0[d][2][w]};
            float out4[4];
            g_transform_1d(col, out4);
            for (int a = 0; a < 4; ++a) t1[d][a][w] = out4[a];
        }
    for (int d = 0; d < 4; ++d)
        for (int h = 0; h < 4; ++h) {
            float col[3] = {t1[d][h][0], t1[d][h][1], t1[d][h][2]};
            float out4[4];
            g_transform_1d(col, out4);
            for (int a = 0; a < 4; ++a) Up[d*16 + h*4 + a] = __float2half(out4[a]);
        }
}

// ---------------------------------------------------------------------
// Kernel 2: input transform. One thread per (channel, tile) -- reads a
// 4x4x4 window from the padded-conceptually input (zero-fill out of
// bounds), separable-transforms it to V. Same widen-on-read/narrow-on-
// store discipline as kernel 1.
// ---------------------------------------------------------------------
__global__ void winograd_input_transform_fp16_$SUFFIX(
    const half* __restrict__ input,  // [Cin][D][H][W]  (B=1)
    half* __restrict__ V,            // [Cin][tiles_d][tiles_h][tiles_w][4][4][4]
    int C_in, int D, int H, int W,
    int tiles_d, int tiles_h, int tiles_w)
{
    long total_tiles = (long)tiles_d * tiles_h * tiles_w;
    long idx = (long)blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= (long)C_in * total_tiles) return;

    int tile_idx = idx % total_tiles;
    int cin = idx / total_tiles;
    int tw = tile_idx % tiles_w;
    int th = (tile_idx / tiles_w) % tiles_h;
    int td = tile_idx / (tiles_w * tiles_h);

    int d0 = 2 * td - 1, h0 = 2 * th - 1, w0 = 2 * tw - 1;

    auto read = [&](int dd, int hh, int ww) -> float {
        if (dd < 0 || dd >= D || hh < 0 || hh >= H || ww < 0 || ww >= W) return 0.0f;
        return __half2float(input[((size_t)cin * D + dd) * H * W + hh * W + ww]);
    };

    float raw[4][4][4];
    for (int a = 0; a < 4; ++a)
        for (int b = 0; b < 4; ++b)
            for (int c = 0; c < 4; ++c)
                raw[a][b][c] = read(d0 + a, h0 + b, w0 + c);

    float t0[4][4][4];
    for (int b = 0; b < 4; ++b)
        for (int c = 0; c < 4; ++c) {
            float col[4] = {raw[0][b][c], raw[1][b][c], raw[2][b][c], raw[3][b][c]};
            float out4[4];
            bt_transform_1d(col, out4);
            for (int a = 0; a < 4; ++a) t0[a][b][c] = out4[a];
        }
    float t1[4][4][4];
    for (int a = 0; a < 4; ++a)
        for (int c = 0; c < 4; ++c) {
            float col[4] = {t0[a][0][c], t0[a][1][c], t0[a][2][c], t0[a][3][c]};
            float out4[4];
            bt_transform_1d(col, out4);
            for (int b = 0; b < 4; ++b) t1[a][b][c] = out4[b];
        }
    half* Vp = V + (size_t)idx * 64;
    for (int a = 0; a < 4; ++a)
        for (int b = 0; b < 4; ++b) {
            float col[4] = {t1[a][b][0], t1[a][b][1], t1[a][b][2], t1[a][b][3]};
            float out4[4];
            bt_transform_1d(col, out4);
            for (int c = 0; c < 4; ++c) Vp[a*16 + b*4 + c] = __float2half(out4[c]);
        }
}

// Shared 3-pass separable output transform: M[64] (float, from kernel 3's
// shared-memory accumulator) -> a 2x2x2 output tile, still in float --
// the FP16 narrowing happens once, at kernel 3's final global-memory
// store, not here.
__device__ __forceinline__ void output_transform_from_shared(const float* M, float out[2][2][2]) {
    float stage1[4][4][2];
    for (int a = 0; a < 4; ++a)
        for (int b = 0; b < 4; ++b) {
            float m[4] = {M[a*16+b*4+0], M[a*16+b*4+1], M[a*16+b*4+2], M[a*16+b*4+3]};
            float o2[2];
            at_transform_1d(m, o2);
            stage1[a][b][0] = o2[0];
            stage1[a][b][1] = o2[1];
        }
    float stage2[4][2][2];
    for (int a = 0; a < 4; ++a)
        for (int c = 0; c < 2; ++c) {
            float m[4] = {stage1[a][0][c], stage1[a][1][c], stage1[a][2][c], stage1[a][3][c]};
            float o2[2];
            at_transform_1d(m, o2);
            stage2[a][0][c] = o2[0];
            stage2[a][1][c] = o2[1];
        }
    for (int b = 0; b < 2; ++b)
        for (int c = 0; c < 2; ++c) {
            float m[4] = {stage2[0][b][c], stage2[1][b][c], stage2[2][b][c], stage2[3][b][c]};
            float o2[2];
            at_transform_1d(m, o2);
            out[0][b][c] = o2[0];
            out[1][b][c] = o2[1];
        }
}

// ---------------------------------------------------------------------
// Kernel 3: register-blocked accumulate + output transform. See file
// header for why BT_TILES/BT_COUT blocking matters. Block = 64 threads;
// grid = (tiles_total/BT_TILES, C_out/BT_COUT). U/V read as half and
// widened to float per element; the C_in-reduction accumulator (`acc`)
// and the shared-memory buffer it's staged through (`M`) both stay float
// for the whole kernel -- only the very final write to `output` narrows
// back to half.
// ---------------------------------------------------------------------
__global__ void winograd_accumulate_output_fp16_$SUFFIX(
    const half* __restrict__ U,     // [Cout][Cin][4][4][4]
    const half* __restrict__ V,     // [Cin][tiles][4][4][4]
    const half* __restrict__ bias,  // [Cout] or nullptr
    half* __restrict__ output,      // [Cout][D_out][H_out][W_out]
    int C_out, int C_in,
    int tiles_d, int tiles_h, int tiles_w,
    int D_out, int H_out, int W_out)
{
    long total_tiles = (long)tiles_d * tiles_h * tiles_w;
    int tile0 = blockIdx.x * WINOGRAD_BT_TILES;
    int cout0 = blockIdx.y * WINOGRAD_BT_COUT;
    int pos = threadIdx.x;  // 0..63

    float acc[WINOGRAD_BT_TILES][WINOGRAD_BT_COUT];
    #pragma unroll
    for (int t = 0; t < WINOGRAD_BT_TILES; ++t)
        #pragma unroll
        for (int c = 0; c < WINOGRAD_BT_COUT; ++c)
            acc[t][c] = 0.0f;

    for (int cin = 0; cin < C_in; ++cin) {
        float uvals[WINOGRAD_BT_COUT];
        #pragma unroll
        for (int c = 0; c < WINOGRAD_BT_COUT; ++c)
            uvals[c] = __half2float(U[((size_t)(cout0 + c) * C_in + cin) * 64 + pos]);
        float vvals[WINOGRAD_BT_TILES];
        #pragma unroll
        for (int t = 0; t < WINOGRAD_BT_TILES; ++t)
            vvals[t] = __half2float(V[((size_t)cin * total_tiles + (tile0 + t)) * 64 + pos]);
        #pragma unroll
        for (int t = 0; t < WINOGRAD_BT_TILES; ++t)
            #pragma unroll
            for (int c = 0; c < WINOGRAD_BT_COUT; ++c) {
                float prod = uvals[c] * vvals[t];   // separate mul then add -- see file header re: FMA
                acc[t][c] = acc[t][c] + prod;
            }
    }

    __shared__ float M[WINOGRAD_BT_TILES][WINOGRAD_BT_COUT][64];
    #pragma unroll
    for (int t = 0; t < WINOGRAD_BT_TILES; ++t)
        #pragma unroll
        for (int c = 0; c < WINOGRAD_BT_COUT; ++c)
            M[t][c][pos] = acc[t][c];
    __syncthreads();

    // Striped loop, not a plain `if (pos < N)` -- stays correct even if
    // WINOGRAD_BT_TILES*WINOGRAD_BT_COUT ever exceeds 64 (see
    // conv3d_fp32_winograd.cu's header for the bug this avoids).
    for (int idx = pos; idx < WINOGRAD_BT_TILES * WINOGRAD_BT_COUT; idx += 64) {
        int t = idx / WINOGRAD_BT_COUT;
        int c = idx % WINOGRAD_BT_COUT;
        int tile_idx = tile0 + t;
        int cout = cout0 + c;

        float out[2][2][2];
        output_transform_from_shared(M[t][c], out);

        int tw = tile_idx % tiles_w;
        int th = (tile_idx / tiles_w) % tiles_h;
        int td = tile_idx / (tiles_w * tiles_h);
        float bv = bias ? __half2float(bias[cout]) : 0.0f;
        for (int a = 0; a < 2; ++a)
            for (int b = 0; b < 2; ++b)
                for (int cc = 0; cc < 2; ++cc) {
                    int od = td*2 + a, oh = th*2 + b, ow = tw*2 + cc;
                    if (od < D_out && oh < H_out && ow < W_out) {
                        output[((size_t)cout * D_out + od) * H_out * W_out + oh * W_out + ow]
                            = __float2half(out[a][b][cc] + bv);
                    }
                }
    }
}

}  // namespace

// ---------------------------------------------------------------------
// Host launcher. Returns false (output untouched) for anything outside
// this kernel's scope -- see file header. Every constraint (kernel=
// 3x3x3, stride=1, padding=1, dilation=1, even D/H/W, divisible
// tile-count/C_out, batch=1) is checked here, before any allocation.
// Runs on `stream` (PyTorch's current HIP stream), not the null stream.
// input/weight/bias/output are void* (not half*) matching this project's
// other fp16 launcher signatures (see conv3d_fp16.cu.tmpl's
// launch_conv3d_fp16_$$SUFFIX) -- unlike conv3d_fp32_winograd.cu's typed
// float* signature, since callers hold fp16 tensors via
// torch::Tensor::data_ptr() (untyped void*), not data_ptr<float>().
// ---------------------------------------------------------------------
extern "C" bool launch_conv3d_fp16_winograd_$SUFFIX(
    const void* input, const void* weight, const void* bias, void* output,
    int B, int C_in, int D_in, int H_in, int W_in,
    int C_out, int K_D, int K_H, int K_W,
    int D_out, int H_out, int W_out,
    int s_d, int s_h, int s_w,
    int p_d, int p_h, int p_w,
    int d_d, int d_h, int d_w,
    hipStream_t stream)
{
    if (B != 1) return false;
    if (K_D != 3 || K_H != 3 || K_W != 3) return false;
    if (s_d != 1 || s_h != 1 || s_w != 1) return false;
    if (p_d != 1 || p_h != 1 || p_w != 1) return false;
    if (d_d != 1 || d_h != 1 || d_w != 1) return false;
    if (D_in % 2 || H_in % 2 || W_in % 2) return false;

    int tiles_d = D_out / 2, tiles_h = H_out / 2, tiles_w = W_out / 2;
    long total_tiles = (long)tiles_d * tiles_h * tiles_w;
    if (total_tiles % WINOGRAD_BT_TILES || C_out % WINOGRAD_BT_COUT) return false;

    const half* input_ptr  = reinterpret_cast<const half*>(input);
    const half* weight_ptr = reinterpret_cast<const half*>(weight);
    const half* bias_ptr   = reinterpret_cast<const half*>(bias);
    half*       output_ptr = reinterpret_cast<half*>(output);

    half *U = nullptr, *V = nullptr;
    if (hipMalloc(&U, (size_t)C_out * C_in * 64 * sizeof(half)) != hipSuccess) return false;
    if (hipMalloc(&V, (size_t)C_in * total_tiles * 64 * sizeof(half)) != hipSuccess) {
        // The (void) casts on hipFree here and at the exit below are only to
        // silence ROCm 7's [[nodiscard]] on hipError_t. Dropping the value is
        // deliberate in both spots: on this path we are already failing back
        // to the direct kernel and have nothing better to do about a free
        // error, and at the exit the launch result (`ok`, from
        // hipGetLastError) is what the caller's fallback decision turns on --
        // a teardown error must not be reported as a kernel that didn't run.
        (void)hipFree(U);
        return false;
    }

    {
        int n = C_out * C_in;
        int block = 128, grid = (n + block - 1) / block;
        hipLaunchKernelGGL(winograd_filter_transform_fp16_$SUFFIX, dim3(grid), dim3(block), 0, stream,
                            weight_ptr, U, C_out, C_in);
    }
    {
        long n = (long)C_in * total_tiles;
        int block = 128;
        long grid = (n + block - 1) / block;
        hipLaunchKernelGGL(winograd_input_transform_fp16_$SUFFIX, dim3((unsigned)grid), dim3(block), 0, stream,
                            input_ptr, V, C_in, D_in, H_in, W_in, tiles_d, tiles_h, tiles_w);
    }
    {
        dim3 grid((unsigned)(total_tiles / WINOGRAD_BT_TILES), C_out / WINOGRAD_BT_COUT);
        hipLaunchKernelGGL(winograd_accumulate_output_fp16_$SUFFIX, grid, dim3(64), 0, stream,
                            U, V, bias_ptr, output_ptr, C_out, C_in, tiles_d, tiles_h, tiles_w,
                            D_out, H_out, W_out);
    }

    bool ok = hipGetLastError() == hipSuccess;
    (void)hipFree(U);
    (void)hipFree(V);
    return ok;
}
